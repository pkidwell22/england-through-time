  "inlets": [
   {
    "id": "queenhithe-inlet",
    "name": "Queenhithe dock",
    "landmark": "queenhithe",
    "lat": 51.5106,
    "lon": -0.095,
    "bearing": 191,
    "width": 34,
    "from": 970,
    "to": null,
    "evidence": "attested-documentary",
    "confidence": "medium",
    "uncertainty": "That Queenhithe stayed an open inlet while the frontage either side was embanked (1021, 1045 and later) is documented; its plan here is not surveyed. The head is put at the model's waterline of about 1000 (where the landmark stands), the 34 m width is the dock model's, the axis is set square to the modelled bank, and the inlet's length is simply wherever the modelled bank stands in each year.",
    "sources": [
     "lamas-saxon-origins-queenhithe-r",
     "bho-stow-queene-hith-warde"
    ]
   },
   {
    "id": "billingsgate-inlet",
    "name": "Billingsgate dock",
    "landmark": "billingsgate",
    "lat": 51.50922,
    "lon": -0.0843,
    "bearing": 185,
    "width": 30,
    "from": 990,
    "to": null,
    "evidence": "attested-documentary",
    "confidence": "low",
    "uncertainty": "Billingsgate is documented as a dock (a water gate with a market) from about 1000 to beyond 1625; its dimensions and the line of its sides are not. The head is put at the model's waterline of about 990 at the foot of the lane to the dock, the 30 m width is the dock model's, the axis is set square to the modelled bank, and the inlet's length is wherever the modelled bank stands in each year.",
    "sources": [
     "bho-stow-billinsgate-warde",
     "mola-medieval-c1066c1500-research-framework"
    ]
   }
  ],
  "note": "The 1625 bank lines are approximated from the modern river with the Victorian embankments removed. Excavated Roman quays (tree-ring dates 52, 63, c. 70, 102 CE and on to the mid 3rd century) advanced the north bank by roughly 35 m; the Roman riverside wall on the Thames Street line then stayed the landward limit, and the remaining ground was won piecemeal between about 1000 and 1500. No verified figure was found for the medieval advance, so the roughly 110 m total and its timing are modelling assumptions. The prehistoric and Roman south bank is modelled as tidal marsh with channels and gravel eyots (the reach was tidal by the Middle to Late Bronze Age); channel positions are illustrative, not mapped.",
  "sources": [
   "london-archaeologist-brigham-watson-regis-house",
